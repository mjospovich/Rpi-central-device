# -----------------------------------------------------------------------------
# InfluxDB Cloud — Telegraf writes here (HTTPS). No InfluxDB container in compose.
# Create org, bucket, and API token in Influx Cloud UI; INFLUX_ORG is often the org *ID* string.
# -----------------------------------------------------------------------------
INFLUX_URL=https://eu-central-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=your-influxdb-cloud-api-token
INFLUX_ORG=your-influx-org-id-or-name
INFLUX_BUCKET=your-bucket-name
