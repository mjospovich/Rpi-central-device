# -----------------------------------------------------------------------------
# InfluxDB Cloud — Telegraf writes here (HTTPS). No InfluxDB container in compose.
# Create org, bucket, and API token in Influx Cloud UI; INFLUX_ORG is often the org *ID* string.
# -----------------------------------------------------------------------------
INFLUX_URL=https://eu-central-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=your-influxdb-cloud-api-token
INFLUX_ORG=your-influx-org-id-or-name
INFLUX_BUCKET=your-bucket-name

# -----------------------------------------------------------------------------
# LoRa dashboard — ChirpStack REST API (create an API key in ChirpStack UI)
# -----------------------------------------------------------------------------
CHIRPSTACK_API_TOKEN=your-chirpstack-api-token-here

# Optional: explicit DL-IAM DevEUIs (usually unnecessary if device names match DECENTLAB_DEVICE_NAME_SUBSTRINGS in compose)
# DL_IAM_DEVEUIS=
# LorBee edge DevEUIs allow-list for custom fPort 10 commands (see docs/lora-dashboard.md)
# EDGE_DEVEUIS=
